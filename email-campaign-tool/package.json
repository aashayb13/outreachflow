{
  "name": "outreachflow",
  "version": "1.0.0",
  "description": "OutreachFlow — personal cold-email and job-application outreach: Apollo lead pulls, Gmail sending, scheduling, sequences, and attachments",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "test": "node --test",
    "electron": "electron .",
    "icon": "node electron/build/make-icon.js",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "email",
    "marketing",
    "campaign",
    "automation"
  ],
  "author": "Aashay Bhujbal",
  "license": "PROPRIETARY",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "pg": "^8.20.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.outreachflow.desktop",
    "productName": "OutreachFlow",
    "asar": true,
    "files": ["src/**/*", "views/**/*", "electron/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "electron/build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OutreachFlow",
      "artifactName": "OutreachFlow-Setup.exe"
    }
  }
}
