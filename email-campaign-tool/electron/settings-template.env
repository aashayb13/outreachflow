# ────────────────────────────────────────────────────────────────
# OutreachFlow — local settings. Fill in the blanks, SAVE, then
# reopen OutreachFlow.
#
# APP_SECRET encrypts your Apollo key and SMTP password inside
# Supabase. SET IT ONCE. If you change it later you must re-enter
# those credentials in the app.
# ────────────────────────────────────────────────────────────────

# Supabase -> Project -> Connect -> Session pooler (port 5432), with your password.
DATABASE_URL=

# Any long random string. Set once, never change.
APP_SECRET=

# ─── Login is OFF by default in the desktop app ───
# The app opens straight to the dashboard — no login needed, so you can leave
# APP_EMAIL / APP_PASSWORD blank. To turn the login screen back ON, set
# DISABLE_AUTH=false below and fill in an email + password of your choosing.
# DISABLE_AUTH=false
# APP_EMAIL=
# APP_PASSWORD=

# ─── Optional SMTP fallback ───
# You can instead set these in the app: Settings -> Email, after logging in.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=
# SMTP_FROM_EMAIL=
