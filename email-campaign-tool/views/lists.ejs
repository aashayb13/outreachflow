

<div x-data="listsApp()" x-init="load()">
  <div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-500" x-text="lists.length + ' lists'"></p>
    <button @click="showCreate = true" class="bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-600">
      <i class="fas fa-plus mr-1"></i> New List
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <template x-for="l in lists" :key="l.id">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-semibold text-gray-800" x-text="l.name"></h3>
          <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-500" x-text="l.type"></span>
        </div>
        <p class="text-sm text-gray-500 mb-3" x-text="l.description || 'No description'"></p>
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-blue-600" x-text="l.contact_count + ' contacts'"></span>
          <div class="flex gap-2">
            <button @click="manageContacts(l)" class="text-gray-400 hover:text-blue-500" title="Manage contacts"><i class="fas fa-users"></i></button>
            <button @click="editList(l)" class="text-gray-400 hover:text-blue-500" title="Edit list"><i class="fas fa-edit"></i></button>
            <button @click="deleteList(l.id)" class="text-gray-400 hover:text-red-500" title="Delete list"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Create/Edit Modal -->
  <div x-show="showCreate" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @click.self="showCreate = false">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6">
      <h3 class="text-lg font-semibold mb-4" x-text="editingId ? 'Edit List' : 'New List'"></h3>
      <form @submit.prevent="saveList()">
        <div class="space-y-4">
          <div><input type="text" x-model="form.name" required placeholder="List Name" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" /></div>
          <div><textarea x-model="form.description" placeholder="Description" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm"></textarea></div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button type="button" @click="showCreate = false; editingId = null" class="px-4 py-2 text-sm text-gray-600">Cancel</button>
          <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg text-sm" x-text="editingId ? 'Update' : 'Create'"></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Manage Contacts Modal -->
  <div x-show="showManage" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @click.self="showManage = false">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl p-6 max-h-[80vh] flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">
          Contacts in <span x-text="manageList?.name"></span>
        </h3>
        <button @click="showManage = false" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
      </div>

      <input type="text" x-model="contactSearch" @input.debounce.300ms="loadAllContacts()"
        placeholder="Search contacts to add..."
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm mb-3" />

      <div class="flex-1 overflow-y-auto border border-gray-200 rounded-lg">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 sticky top-0">
            <tr>
              <th class="text-left px-3 py-2 text-xs font-medium text-gray-500 uppercase w-10"></th>
              <th class="text-left px-3 py-2 text-xs font-medium text-gray-500 uppercase">Email</th>
              <th class="text-left px-3 py-2 text-xs font-medium text-gray-500 uppercase">Name</th>
              <th class="text-left px-3 py-2 text-xs font-medium text-gray-500 uppercase">Company</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <template x-for="c in allContacts" :key="c.id">
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2">
                  <input type="checkbox"
                    :checked="memberIds.has(c.id)"
                    @change="toggleContact(c.id, $event.target.checked)" />
                </td>
                <td class="px-3 py-2 text-gray-700" x-text="c.email"></td>
                <td class="px-3 py-2 text-gray-600" x-text="(c.first_name + ' ' + c.last_name).trim() || '-'"></td>
                <td class="px-3 py-2 text-gray-600" x-text="c.company || '-'"></td>
              </tr>
            </template>
            <tr x-show="allContacts.length === 0">
              <td colspan="4" class="px-3 py-6 text-center text-gray-400">No contacts found. Create some on the Contacts page first.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between mt-4">
        <p class="text-sm text-gray-500">
          <span x-text="memberIds.size"></span> selected
        </p>
        <button @click="showManage = false" class="bg-blue-500 text-white px-6 py-2 rounded-lg text-sm">Done</button>
      </div>
    </div>
  </div>
</div>

<script>
function listsApp() {
  return {
    lists: [], showCreate: false, editingId: null,
    form: { name: '', description: '' },

    // Manage-contacts modal state
    showManage: false,
    manageList: null,
    allContacts: [],
    memberIds: new Set(),
    contactSearch: '',

    async load() {
      const data = await api.get('/api/lists');
      this.lists = data.lists;
    },

    editList(l) {
      this.editingId = l.id;
      this.form = { name: l.name, description: l.description };
      this.showCreate = true;
    },

    async saveList() {
      try {
        if (this.editingId) {
          await api.put(`/api/lists/${this.editingId}`, this.form);
          toast('List updated');
        } else {
          await api.post('/api/lists', this.form);
          toast('List created');
        }
        this.showCreate = false;
        this.editingId = null;
        this.form = { name: '', description: '' };
        this.load();
      } catch (e) {}
    },

    async deleteList(id) {
      if (!confirm('Delete this list?')) return;
      try { await api.del(`/api/lists/${id}`); toast('List deleted'); this.load(); } catch (e) {}
    },

    async manageContacts(l) {
      this.manageList = l;
      this.showManage = true;
      this.contactSearch = '';
      this.memberIds = new Set();
      // Load list members + all contacts in parallel
      const [listData, _] = await Promise.all([
        api.get(`/api/lists/${l.id}?limit=10000`),
        this.loadAllContacts(),
      ]);
      this.memberIds = new Set((listData.contacts || []).map(c => c.id));
    },

    async loadAllContacts() {
      const params = new URLSearchParams({ limit: 200, search: this.contactSearch || '' });
      const data = await api.get('/api/contacts?' + params);
      this.allContacts = data.contacts;
    },

    async toggleContact(contactId, checked) {
      try {
        if (checked) {
          await api.post(`/api/lists/${this.manageList.id}/contacts`, { contact_ids: [contactId] });
          this.memberIds.add(contactId);
        } else {
          await api.del(`/api/lists/${this.manageList.id}/contacts`, { contact_ids: [contactId] });
          this.memberIds.delete(contactId);
        }
        // Update the count badge on the card without a full reload
        const idx = this.lists.findIndex(x => x.id === this.manageList.id);
        if (idx >= 0) this.lists[idx].contact_count = this.memberIds.size;
      } catch (e) {
        toast('Failed to update list', 'error');
      }
    },
  };
}
</script>
