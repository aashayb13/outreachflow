

<div x-data="webhooksApp()" x-init="load()">
  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="text-sm text-gray-500">Outbound webhooks notify external services when events occur.</p>
      <p class="text-sm text-gray-400 mt-1">Inbound endpoint: <code class="bg-gray-100 px-2 py-0.5 rounded text-xs">POST /api/webhooks/inbound/{action}</code></p>
    </div>
    <button @click="showCreate = true" class="bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-600">
      <i class="fas fa-plus mr-1"></i> New Webhook
    </button>
  </div>

  <div class="space-y-4">
    <template x-for="w in webhooks" :key="w.id">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-3">
              <h3 class="font-semibold text-gray-800" x-text="w.name"></h3>
              <span class="text-xs px-2 py-1 rounded-full" :class="w.is_active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'" x-text="w.is_active ? 'Active' : 'Disabled'"></span>
            </div>
            <p class="text-xs text-gray-400 mt-1 font-mono" x-text="w.url"></p>
            <p class="text-xs text-gray-400 mt-1">Events: <span x-text="w.events.join(', ')"></span></p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs text-gray-400" x-text="w.last_triggered ? 'Last: ' + new Date(w.last_triggered).toLocaleString() : 'Never fired'"></span>
            <button @click="testWebhook(w.id)" class="text-xs bg-gray-100 text-gray-700 px-3 py-1 rounded hover:bg-gray-200"><i class="fas fa-play mr-1"></i> Test</button>
            <button @click="toggleWebhook(w)" class="text-gray-400 hover:text-yellow-500"><i class="fas fa-power-off"></i></button>
            <button @click="deleteWebhook(w.id)" class="text-gray-400 hover:text-red-500"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>
    </template>
    <div x-show="webhooks.length === 0" class="bg-white rounded-xl p-8 text-center text-gray-400 shadow-sm">No webhooks configured</div>
  </div>

  <!-- Create Modal -->
  <div x-show="showCreate" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @click.self="showCreate = false">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6">
      <h3 class="text-lg font-semibold mb-4">New Webhook</h3>
      <form @submit.prevent="create()">
        <div class="space-y-4">
          <div><input type="text" x-model="form.name" required placeholder="Webhook Name" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" /></div>
          <div><input type="url" x-model="form.url" required placeholder="https://your-service.com/webhook" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" /></div>
          <div><input type="text" x-model="form.secret" placeholder="Signing Secret (optional)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" /></div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Events</label>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <label class="flex items-center gap-2"><input type="checkbox" value="*" x-model="form.events" /> All Events</label>
              <label class="flex items-center gap-2"><input type="checkbox" value="email.opened" x-model="form.events" /> Email Opened</label>
              <label class="flex items-center gap-2"><input type="checkbox" value="email.clicked" x-model="form.events" /> Email Clicked</label>
              <label class="flex items-center gap-2"><input type="checkbox" value="email.bounced" x-model="form.events" /> Bounced</label>
              <label class="flex items-center gap-2"><input type="checkbox" value="contact.created" x-model="form.events" /> Contact Created</label>
              <label class="flex items-center gap-2"><input type="checkbox" value="contact.unsubscribed" x-model="form.events" /> Unsubscribed</label>
              <label class="flex items-center gap-2"><input type="checkbox" value="campaign.sent" x-model="form.events" /> Campaign Sent</label>
              <label class="flex items-center gap-2"><input type="checkbox" value="sequence.completed" x-model="form.events" /> Sequence Done</label>
            </div>
          </div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button type="button" @click="showCreate = false" class="px-4 py-2 text-sm text-gray-600">Cancel</button>
          <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg text-sm">Create</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function webhooksApp() {
  return {
    webhooks: [], showCreate: false,
    form: { name: '', url: '', secret: '', events: ['*'] },

    async load() { const data = await api.get('/api/webhooks'); this.webhooks = data.webhooks; },

    async create() {
      try {
        await api.post('/api/webhooks', this.form);
        this.showCreate = false;
        this.form = { name: '', url: '', secret: '', events: ['*'] };
        toast('Webhook created');
        this.load();
      } catch (e) {}
    },

    async testWebhook(id) {
      try {
        const data = await api.post(`/api/webhooks/${id}/test`);
        toast(data.success ? 'Test successful' : 'Test failed: ' + (data.error || ''), data.success ? 'success' : 'error');
      } catch (e) {}
    },

    async toggleWebhook(w) {
      try { await api.put(`/api/webhooks/${w.id}`, { is_active: !w.is_active }); toast(w.is_active ? 'Webhook disabled' : 'Webhook enabled'); this.load(); } catch (e) {}
    },

    async deleteWebhook(id) {
      if (!confirm('Delete?')) return;
      try { await api.del(`/api/webhooks/${id}`); toast('Deleted'); this.load(); } catch (e) {}
    },
  };
}
</script>
