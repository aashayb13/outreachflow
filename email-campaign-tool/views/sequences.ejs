

<div x-data="sequencesApp()" x-init="load()">
  <div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-500" x-text="sequences.length + ' sequences'"></p>
    <button @click="showCreate = true" class="bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-600">
      <i class="fas fa-plus mr-1"></i> New Sequence
    </button>
  </div>

  <div class="space-y-4">
    <template x-for="s in sequences" :key="s.id">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-3">
              <h3 class="font-semibold text-gray-800" x-text="s.name"></h3>
              <span class="text-xs px-2 py-1 rounded-full"
                :class="{ 'bg-green-100 text-green-700': s.status === 'active', 'bg-gray-100 text-gray-600': s.status === 'draft', 'bg-yellow-100 text-yellow-700': s.status === 'paused' }"
                x-text="s.status"></span>
            </div>
            <p class="text-sm text-gray-500 mt-1" x-text="s.description || 'No description'"></p>
          </div>
          <div class="flex items-center gap-6 text-sm">
            <div class="text-center">
              <p class="font-bold text-gray-800" x-text="s.step_count"></p>
              <p class="text-xs text-gray-400">Steps</p>
            </div>
            <div class="text-center">
              <p class="font-bold text-gray-800" x-text="s.total_enrolled"></p>
              <p class="text-xs text-gray-400">Enrolled</p>
            </div>
            <div class="text-center">
              <p class="font-bold text-blue-600" x-text="s.active_enrollments"></p>
              <p class="text-xs text-gray-400">Active</p>
            </div>
            <div class="flex gap-2">
              <button x-show="s.status === 'draft'" @click="activate(s.id)" class="text-xs bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600">Activate</button>
              <button x-show="s.status === 'active'" @click="pause(s.id)" class="text-xs bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600">Pause</button>
              <button x-show="s.status === 'paused'" @click="activate(s.id)" class="text-xs bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600">Resume</button>
              <a :href="'/sequences/' + s.id" class="text-gray-400 hover:text-blue-500"><i class="fas fa-edit"></i></a>
              <button @click="deleteSeq(s.id)" class="text-gray-400 hover:text-red-500"><i class="fas fa-trash"></i></button>
            </div>
          </div>
        </div>
      </div>
    </template>
    <div x-show="sequences.length === 0" class="bg-white rounded-xl p-8 text-center text-gray-400 shadow-sm">No sequences yet</div>
  </div>

  <!-- Create Modal -->
  <div x-show="showCreate" x-cloak class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @click.self="showCreate = false">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6">
      <h3 class="text-lg font-semibold mb-4">New Sequence</h3>
      <form @submit.prevent="createSeq()">
        <div class="space-y-4">
          <div><input type="text" x-model="form.name" required placeholder="Sequence Name" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" /></div>
          <div><textarea x-model="form.description" placeholder="Description" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm"></textarea></div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Trigger</label>
            <select x-model="form.trigger_type" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
              <option value="manual">Manual</option>
              <option value="list_join">List Join</option>
              <option value="tag_added">Tag Added</option>
              <option value="webhook">Webhook</option>
            </select>
          </div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button type="button" @click="showCreate = false" class="px-4 py-2 text-sm text-gray-600">Cancel</button>
          <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-lg text-sm">Create</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function sequencesApp() {
  return {
    sequences: [], showCreate: false,
    form: { name: '', description: '', trigger_type: 'manual' },

    async load() {
      const data = await api.get('/api/sequences');
      this.sequences = data.sequences;
    },
    async createSeq() {
      try {
        await api.post('/api/sequences', this.form);
        this.showCreate = false;
        this.form = { name: '', description: '', trigger_type: 'manual' };
        toast('Sequence created');
        this.load();
      } catch (e) {}
    },
    async activate(id) { try { await api.put(`/api/sequences/${id}`, { status: 'active' }); toast('Activated'); this.load(); } catch (e) {} },
    async pause(id) { try { await api.put(`/api/sequences/${id}`, { status: 'paused' }); toast('Paused'); this.load(); } catch (e) {} },
    async deleteSeq(id) { if (!confirm('Delete?')) return; try { await api.del(`/api/sequences/${id}`); toast('Deleted'); this.load(); } catch (e) {} },
  };
}
</script>
