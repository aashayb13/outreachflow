

<div x-data="settingsApp()" x-init="load()">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Email (SMTP) Settings -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h3 class="font-semibold text-gray-700 mb-4"><i class="fas fa-envelope text-gray-400 mr-2"></i>Email (SMTP)</h3>
      <div class="space-y-3 text-sm">
        <div>
          <label class="block text-gray-500 mb-1">From name</label>
          <input x-model="smtp.fromName" class="w-full border border-gray-300 rounded-lg px-3 py-2" placeholder="Your Name" />
        </div>
        <div>
          <label class="block text-gray-500 mb-1">From email</label>
          <input x-model="smtp.fromEmail" class="w-full border border-gray-300 rounded-lg px-3 py-2" placeholder="you@gmail.com" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-gray-500 mb-1">SMTP host</label>
            <input x-model="smtp.host" class="w-full border border-gray-300 rounded-lg px-3 py-2" placeholder="smtp.gmail.com" />
          </div>
          <div>
            <label class="block text-gray-500 mb-1">Port</label>
            <input x-model="smtp.port" type="number" class="w-full border border-gray-300 rounded-lg px-3 py-2" placeholder="587" />
          </div>
        </div>
        <div>
          <label class="block text-gray-500 mb-1">SMTP user</label>
          <input x-model="smtp.user" class="w-full border border-gray-300 rounded-lg px-3 py-2" placeholder="you@gmail.com" />
        </div>
        <div>
          <label class="block text-gray-500 mb-1">Password / App password</label>
          <input x-model="smtp.pass" type="password" class="w-full border border-gray-300 rounded-lg px-3 py-2"
                 :placeholder="smtp.has_pass ? '******** (leave blank to keep current)' : 'Gmail 16-char app password'" />
        </div>
        <label class="flex items-center gap-2 text-gray-600">
          <input type="checkbox" x-model="smtp.secure" /> Use SSL (port 465)
        </label>
      </div>
      <div class="flex items-center gap-2 mt-4">
        <button @click="saveSMTP()" class="bg-green-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-green-600"><i class="fas fa-save mr-1"></i> Save</button>
        <button @click="testSMTP()" class="bg-blue-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-600"><i class="fas fa-plug mr-1"></i> Test</button>
        <span class="text-xs text-gray-400" x-text="'Source: ' + (smtp.source || 'env')"></span>
      </div>
      <p x-show="smtpStatus" class="mt-2 text-sm" :class="smtpOk ? 'text-green-600' : 'text-red-600'" x-text="smtpStatus"></p>
      <p class="text-xs text-gray-400 mt-3">Gmail needs an App Password (2FA must be on). Stored encrypted in your database.</p>
    </div>

    <!-- API Keys -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h3 class="font-semibold text-gray-700 mb-4"><i class="fas fa-key text-gray-400 mr-2"></i>API Keys</h3>
      <div class="space-y-3 mb-4">
        <template x-for="k in apiKeys" :key="k.id">
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
            <div>
              <p class="text-sm font-medium text-gray-800" x-text="k.name"></p>
              <p class="text-xs text-gray-400" x-text="'Prefix: ' + k.prefix + '... | Permissions: ' + k.permissions.join(', ')"></p>
            </div>
            <button @click="deleteKey(k.id)" class="text-red-400 hover:text-red-600"><i class="fas fa-trash"></i></button>
          </div>
        </template>
        <p x-show="apiKeys.length === 0" class="text-sm text-gray-400">No API keys created</p>
      </div>
      <div class="flex items-center gap-2">
        <input type="text" x-model="newKeyName" placeholder="Key name" class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm" />
        <button @click="createKey()" class="bg-green-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-green-600">Generate</button>
      </div>
      <div x-show="newKey" class="mt-3 p-3 bg-green-50 rounded-lg">
        <p class="text-xs text-green-700 font-medium mb-1">Save this key now — it won't be shown again:</p>
        <code class="text-sm text-green-800 break-all" x-text="newKey"></code>
      </div>
    </div>

    <!-- Suppression List -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h3 class="font-semibold text-gray-700 mb-4"><i class="fas fa-ban text-gray-400 mr-2"></i>Suppression List</h3>
      <p class="text-sm text-gray-500 mb-3" x-text="suppressionCount + ' suppressed emails'"></p>
      <a href="/analytics" class="text-sm text-blue-500 hover:underline">Manage in Analytics</a>
    </div>

    <!-- System Info -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h3 class="font-semibold text-gray-700 mb-4"><i class="fas fa-info-circle text-gray-400 mr-2"></i>System</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">Send Rate</span><span class="text-gray-800"><%= typeof send_rate !== 'undefined' ? send_rate : '-' %>/sec, <%= typeof send_daily !== 'undefined' ? send_daily : '-' %>/day</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Tracking Domain</span><span class="text-gray-800 font-mono"><%= typeof tracking_domain !== 'undefined' ? tracking_domain : '-' %></span></div>
      </div>
    </div>

    <!-- Gmail sending guidance -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h3 class="font-semibold text-gray-700 mb-4"><i class="fas fa-shield-halved text-gray-400 mr-2"></i>Gmail Sending &amp; Deliverability</h3>
      <ul class="text-sm text-gray-600 space-y-2 list-disc pl-5">
        <li>Personal Gmail caps at ~500 recipients/day. Current cap: <span class="font-mono"><%= typeof send_daily !== 'undefined' ? send_daily : '-' %>/day</span>.</li>
        <li>Start low (~40/day) and raise by ~10–20/day each week to protect your inbox reputation.</li>
        <li>Keep open/click tracking <strong>off</strong> for cold email — it hurts deliverability and looks like marketing.</li>
        <li>Requires a Google <strong>App Password</strong> (2FA must be enabled). <code>SMTP_FROM_EMAIL</code> must match your Gmail address.</li>
      </ul>
    </div>
  </div>
</div>

<script>
function settingsApp() {
  return {
    apiKeys: [], newKeyName: '', newKey: '', smtpStatus: '', smtpOk: false, suppressionCount: 0,
    smtp: { host: '', port: 587, secure: false, user: '', pass: '', has_pass: false, fromName: '', fromEmail: '', source: 'env' },

    async load() {
      const kData = await api.get('/api/auth/api-keys');
      this.apiKeys = kData.api_keys;

      const sData = await api.get('/api/analytics/suppression?limit=1');
      this.suppressionCount = sData.pagination.total;

      const sm = await api.get('/api/settings/smtp');
      this.smtp = { ...this.smtp, ...sm.smtp };
      this.smtp.pass = '';  // never bind the masked placeholder into the input; blank = keep existing password
    },

    async saveSMTP() {
      try {
        const d = await api.put('/api/settings/smtp', this.smtp);
        this.smtp = { ...this.smtp, ...d.smtp, pass: '' };
        toast('SMTP settings saved');
      } catch (e) {}
    },

    async testSMTP() {
      this.smtpStatus = 'Testing...';
      try {
        const d = await api.post('/api/settings/smtp/test', this.smtp);
        this.smtpOk = d.success;
        this.smtpStatus = d.success ? 'Connection successful!' : 'Failed: ' + (d.error || 'Unknown error');
      } catch (e) {
        this.smtpOk = false;
        this.smtpStatus = 'Connection failed';
      }
    },

    async createKey() {
      if (!this.newKeyName) return toast('Enter a key name', 'warning');
      try {
        const data = await api.post('/api/auth/api-keys', { name: this.newKeyName, permissions: ['read', 'write'] });
        this.newKey = data.api_key;
        this.newKeyName = '';
        toast('API key created');
        this.load();
      } catch (e) {}
    },

    async deleteKey(id) {
      if (!confirm('Delete this API key?')) return;
      try { await api.del(`/api/auth/api-keys/${id}`); toast('Key deleted'); this.load(); } catch (e) {}
    },
  };
}
</script>
