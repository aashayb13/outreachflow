<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Error <%= status %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen">
  <div class="text-center">
    <h1 class="text-6xl font-bold text-gray-300"><%= status %></h1>
    <p class="text-xl text-gray-600 mt-4"><%= message %></p>
    <a href="/" class="inline-block mt-6 px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">Go Home</a>
  </div>
</body>
</html>
