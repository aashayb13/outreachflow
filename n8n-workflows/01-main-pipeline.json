    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ============================================================\n// NORMALIZE CORNERSIGHT PAYLOAD\n// ============================================================\n// Cornersight may send single events or batches.\n// This node normalises every payload into a consistent shape.\n// If a batch array is detected, upstream 'Split In Batches'\n// will have already broken it into individual items.\n// ============================================================\n\nconst raw = $input.item.json;\n\n// Handle both flat and nested payload shapes\nconst data = raw.engagement || raw;\n\nconst fullName = (data.person_name || data.name || '').trim();\nconst parts = fullName.split(' ');\nconst firstName = parts[0] || '';\nconst lastName  = parts.slice(1).join(' ') || '';\n\nreturn {\n  json: {\n    first_name:       firstName,\n    last_name:        lastName,\n    full_name:        fullName,\n    linkedin_url:     (data.linkedin_url || data.profile_url || '').trim(),\n    post_url:         (data.post_url || '').trim(),\n    engagement_type:  (data.engagement_type || data.type || 'like').toLowerCase(),\n    comment_text:     (data.comment_text || data.comment || ''),\n    job_title:        (data.job_title || data.title || '').trim(),\n    company:          (data.company || data.company_name || '').trim(),\n    location:         (data.location || '').trim(),\n    industry:         (data.industry || '').trim(),\n    monitor_name:     (data.monitor_name || data.monitor || data.source || 'Unknown'),\n    received_at:      new Date().toISOString()\n  }\n};"
      },
      "id": "normalize-data",
      "name": "Normalize Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ============================================================\n// BATCH SPLITTER\n// ============================================================\n// If Cornersight sends a daily batch with an \"engagements\" array,\n// split it into individual items. If it is a single event, pass through.\n// ============================================================\n\nconst raw = $input.item.json;\n\nif (Array.isArray(raw.engagements) && raw.engagements.length > 0) {\n  // Batch payload — return each engagement as a separate item\n  return raw.engagements.map(e => ({\n    json: {\n      ...e,\n      monitor_name: e.monitor_name || raw.monitor_name || 'Unknown'\n    }\n  }));\n}\n\n// Single event — pass through as-is\nreturn [{ json: raw }];"
      },
      "id": "batch-splitter",
      "name": "Split Batch Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 480]
    },
    {
