    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ============================================================\n// MERGE LEAD MAGIC RESPONSE WITH ORIGINAL LEAD DATA\n// ============================================================\n\nconst lead    = $('Normalize Fields').item.json;\nconst enriched = $input.item.json;\n\nreturn {\n  json: {\n    ...lead,\n    email:      enriched.email || null,\n    confidence: enriched.confidence || 0,\n    email_type: enriched.type || 'unknown',\n    // Override with Lead Magic data if our original was empty\n    company:    lead.company || enriched.company || '',\n    job_title:  lead.job_title || enriched.job_title || '',\n    location:   lead.location || enriched.location || ''\n  }\n};"
      },
      "id": "merge-enrichment",
      "name": "Merge Enrichment Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 300]
    },
    {
