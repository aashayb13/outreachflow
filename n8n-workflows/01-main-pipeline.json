    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ============================================================\n// DETERMINE PLUSVIBE CAMPAIGN ID BASED ON MONITOR SOURCE\n// ============================================================\n// IMPORTANT: Replace the placeholder campaign IDs below with\n// your actual Plusvibe campaign IDs after creating them.\n// ============================================================\n\nconst CAMPAIGN_MAP = {\n  'Jobber':       'REPLACE_WITH_JOBBER_CAMPAIGN_ID',\n  'ServiceTitan': 'REPLACE_WITH_SERVICETITAN_CAMPAIGN_ID',\n  'Cold IQ':      'REPLACE_WITH_COLDIQ_CAMPAIGN_ID',\n  'Housecall Pro': 'REPLACE_WITH_HOUSECALLPRO_CAMPAIGN_ID',\n  'FieldEdge':    'REPLACE_WITH_FIELDEDGE_CAMPAIGN_ID',\n  'GoHighLevel':  'REPLACE_WITH_GOHIGHLEVEL_CAMPAIGN_ID',\n  'Tommy Mello':  'REPLACE_WITH_TOMMYMELLO_CAMPAIGN_ID',\n  'Adi Klevit':   'REPLACE_WITH_ADIKLEVIT_CAMPAIGN_ID',\n  'Successware':  'REPLACE_WITH_SUCCESSWARE_CAMPAIGN_ID',\n  'BuildOps':     'REPLACE_WITH_BUILDOPS_CAMPAIGN_ID'\n};\n\nconst DEFAULT_CAMPAIGN = 'REPLACE_WITH_DEFAULT_CAMPAIGN_ID';\n\nconst monitor = $json.monitor_name || 'Unknown';\nconst campaignId = CAMPAIGN_MAP[monitor] || DEFAULT_CAMPAIGN;\n\n// Truncate comment for email personalization\nconst commentSnippet = ($json.comment_text || '').substring(0, 80);\n\nreturn {\n  json: {\n    ...$json,\n    campaign_id: campaignId,\n    comment_snippet: commentSnippet\n  }\n};"
      },
