        "jsCode": "// ============================================================\n// LOG FILTERED-OUT / FAILED LEADS\n// ============================================================\n// This node receives leads that were dropped at any filter stage\n// or failed enrichment. It determines the reason and logs it.\n// ============================================================\n\nconst lead = $input.item.json;\nlet reason = 'unknown';\n\n// Determine which filter dropped this lead based on the source node\nconst sourceNode = $input.item.json._filterSource || 'unknown';\n\nreturn {\n  json: {\n    status: 'FILTERED',\n    reason: sourceNode,\n    name: `${lead.first_name || ''} ${lead.last_name || ''}`.trim() || lead.full_name || 'Unknown',\n    linkedin_url: lead.linkedin_url || '',\n    job_title: lead.job_title || '',\n    company: lead.company || '',\n    location: lead.location || '',\n    industry: lead.industry || '',\n    monitor: lead.monitor_name || '',\n    email: lead.email || '',\n    confidence: lead.confidence || '',\n    timestamp: new Date().toISOString()\n  }\n};"
